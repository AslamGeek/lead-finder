# Copy to .env.local for local demo (no Docker, Postgres or Redis required).
APP_MODE=demo
DATABASE_URL=sqlite:///./fieldatlas-demo.db
REDIS_URL=
API_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=
# Managed production: APP_MODE=live; PostgreSQL+PostGIS and Redis are then required.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# REDIS_URL=rediss://default:PASSWORD@HOST:6379/0?ssl_cert_reqs=required
# API_KEY=<at least 24 random characters, stored only on the backend host>
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-branch-preview.vercel.app
GEOCODING_PROVIDER=photon
GEOCODING_API_KEY=
USER_AGENT=FieldAtlas/1.0 (set your contact email before live discovery)
MAX_TOTAL_SEARCH_TERMS=30
MAX_RESULTS_PER_QUERY=100
MAX_EXPANSIONS_PER_TERM=8
MAX_DISCOVERY_ROUNDS=2
MAX_PAGES_PER_DOMAIN=8
MAX_HTML_BYTES_PER_PAGE=1000000
MAX_CRAWL_PAGES_PER_JOB=400
CRAWL_ENABLED=false
REQUEST_TIMEOUT=20

